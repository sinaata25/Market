SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required in production. Leave blank only for local SQLite development.
DATABASE_URL=

# Shared SMS provider for OTP and order events. The console is a safe local default;
# use ippanel only after filling the provider values and approved patterns below.
OTP_SMS_BACKEND=console
ORDER_SMS_ENABLED=true
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RETENTION_DAYS=7
OTP_SEND_IP_RATE=30/hour
OTP_SEND_PHONE_RATE=5/hour
OTP_VERIFY_IP_RATE=100/hour
OTP_VERIFY_PHONE_RATE=20/hour
TRUSTED_PROXY_COUNT=0

# Production always requires Redis for shared, atomic throttle counters.
# Set true only to enforce Redis during development too.
OTP_REQUIRE_SHARED_CACHE=false
REDIS_URL=
CACHE_KEY_PREFIX=market

# Production: set OTP_SMS_BACKEND=ippanel and fill all values below.
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=
IPPANEL_PATTERN_CODE=
IPPANEL_OTP_PARAMETER=otp_code
# Approved pattern params:
#   new order: customer_name, order_code
#   status update: order_code, status
IPPANEL_NEW_ORDER_PATTERN_CODE=
IPPANEL_ORDER_STATUS_PATTERN_CODE=
IPPANEL_CONNECT_TIMEOUT=3
IPPANEL_READ_TIMEOUT=10
