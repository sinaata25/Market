SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required in production. Leave blank only for local SQLite development.
DATABASE_URL=

# Safe local default. Use ippanel only after filling the provider values below.
OTP_SMS_BACKEND=console
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RETENTION_DAYS=7
OTP_SEND_IP_RATE=30/hour
OTP_SEND_PHONE_RATE=5/hour
OTP_VERIFY_IP_RATE=100/hour
OTP_VERIFY_PHONE_RATE=20/hour
TRUSTED_PROXY_COUNT=0

# Production always requires Redis for shared, atomic throttle counters.
# Set true only to enforce Redis during development too.
OTP_REQUIRE_SHARED_CACHE=false
REDIS_URL=
CACHE_KEY_PREFIX=market

# Production: set OTP_SMS_BACKEND=ippanel and fill all values below.
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=
IPPANEL_OTP_PATTERN_CODE=b9f8d6co8e5z6de
IPPANEL_NEW_ORDER_PATTERN_CODE=3v0og6lgz3ixp8i
IPPANEL_ORDER_STATUS_PATTERN_CODE=fivdiyj4psxj94k
IPPANEL_CONNECT_TIMEOUT=3
IPPANEL_READ_TIMEOUT=10

# Invoice branding defaults to the current monorepo storefront assets. Override
# these absolute paths when frontend and backend are packaged separately.
# INVOICE_STORE_NAME=گروه صنعتی توانا
# INVOICE_LOGO_PATH=/absolute/path/to/logo.png
# INVOICE_FONT_REGULAR_PATH=/absolute/path/to/Vazirmatn-Regular.woff2
# INVOICE_FONT_BOLD_PATH=/absolute/path/to/Vazirmatn-Bold.woff2

# فوتر روی هر صفحه‌ی فروشگاه کش می‌شود. با تنظیم این دو مقدار، بک‌اند بعد از
# هر تغییر مدیر، کش فوتر را در Next باطل می‌کند. خالی = فقط انقضای زمانی.
# FRONTEND_REVALIDATE_URL=http://127.0.0.1:3000/internal/revalidate
# FRONTEND_REVALIDATE_SECRET=

# جست‌وجوی نشانی برای انتخابگر نقشه‌ی داشبورد (بدون کلید، فقط برای مدیران).
# نمونه‌ی عمومی Nominatim برای استفاده‌ی سبک رایگان است؛ در استقرار واقعی
# User-Agent را با دامنه/ایمیل سایت پر کنید و در ترافیک بالا نمونه‌ی
# اختصاصی خودتان را بگذارید.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=YourStore/1.0 (admin@example.com)
# FOOTER_GEOCODE_RATE=120/hour
