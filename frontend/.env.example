BACKEND_URL="http://127.0.0.1:8000"
SITE_URL="http://localhost:3000"
# باید با FRONTEND_REVALIDATE_SECRET در بک‌اند یکسان باشد
# FRONTEND_REVALIDATE_SECRET=

# نقشه‌ی فوتر بدون کلید کار می‌کند (مسیر جاسازی ساده‌ی گوگل مپس، بدون هزینه).
# اگر کلید Maps Embed API دارید، اینجا بگذارید تا مسیر رسمی به کار برود.
# کلید در آدرس iframe دیده می‌شود، پس حتماً با HTTP referrer محدودش کنید.
# GOOGLE_MAPS_EMBED_API_KEY=
